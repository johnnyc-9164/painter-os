# Intended runtime; unset defaults to cloud and never silently falls back.
PAINTER_RUNTIME=convex
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
# Your web application's exact origin, for CSRF validation.
PAINTER_APP_URL=
# Securely configure >=32 random characters on the web host. Never use NEXT_PUBLIC.
PAINTER_LINK_SECRET=
# Synthetic demo disabled in hosted environments by default.
PAINTER_ALLOW_DEMO=false

# Local acceptance only, never an internet-facing identity backend:
# PAINTER_RUNTIME=local
# PAINTER_ALLOW_DEMO=true
# PAINTER_DATA_DIR=/absolute/path/to/private/test-data
# PAINTER_COOKIE_SECURE=false  # loopback HTTP only

# Configure on the Convex backend itself, not as public client variables:
# SITE_URL=<your web application's origin>
# BETTER_AUTH_SECRET=<securely configured secret>
