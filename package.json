{
  "name": "painter-os-bts",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "npm run build --workspace web",
    "build:vercel": "node scripts/vercel-build.mjs",
    "test:vercel-build": "node --test tests/vercel-build.test.mjs",
    "build:marketing": "npm run build --workspace marketing",
    "test:marketing": "node --test tests/marketing-boundary.test.mjs",
    "check-types": "npm run check-types --workspace web && npm run check-types --workspace @painter-os-bts/domain && tsc --noEmit -p packages/backend/convex/tsconfig.json && npm run check-types --workspace marketing && npm run check-types --workspace company-site && npm run check-types --workspace platform-admin && npm run check-types --workspace @painter-os-bts/agent-worker",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev -F @painter-os-bts/backend --",
    "dev:setup": "turbo run dev:setup -F @painter-os-bts/backend --",
    "env:generate": "varlock codegen --path ./apps/web/",
    "test": "tsx --test tests/*.test.ts && npm run test:node-mjs && npm run test:factory-contracts && npm run test:marketing && npm run test:vercel-build && npm run test:forms && npm run test:company-site && npm run test:platform-admin && npm run test:agent-worker",
    "lint": "eslint apps/web/src apps/marketing/src apps/company-site/src apps/platform-admin/src packages/platform-admin-ui/src packages/cloud-session/src packages/domain/src packages/agent-worker/src packages/agent-worker/tests/fixtures/*.ts tests",
    "verify": "npm run check-types && npm run lint && npm test && npm run test:convex && npm run build",
    "test:convex": "vitest run --config vitest.product.config.ts",
    "test:http": "node tests/http.acceptance.mjs",
    "test:browser": "node tests/browser.acceptance.mjs",
    "dev:local": "PAINTER_RUNTIME=local PAINTER_ALLOW_DEMO=true npm run dev --workspace web",
    "start:local": "PAINTER_RUNTIME=local PAINTER_ALLOW_DEMO=true PAINTER_COOKIE_SECURE=false npm run start --workspace web",
    "test:forms": "vitest run --config vitest.forms.config.ts",
    "agent:doctor": "node scripts/agent-doctor.mjs",
    "agent:check": "node scripts/agent-check.mjs",
    "agent:dev": "node scripts/agent-dev.mjs",
    "agent:observe": "node scripts/agent-observe.mjs",
    "agent:browser": "node scripts/agent-browser.mjs",
    "agent:verify": "node scripts/agent-verify.mjs",
    "agent:garden": "node scripts/agent-check.mjs --garden",
    "agent:schema": "node scripts/agent-check.mjs --write-schema",
    "test:agent": "node --test tests/agent-*.test.mjs",
    "worktree:setup": "node scripts/worktree-setup.mjs",
    "worktree:cleanup": "node scripts/worktree-cleanup.mjs",
    "build:company-site": "npm run build --workspace company-site",
    "test:company-site": "node --test tests/company-site-boundary.test.mjs",
    "test:http:company-site": "node --test tests/company-site.http.acceptance.mjs",
    "build:platform-admin": "npm run build --workspace platform-admin",
    "test:platform-admin": "node --test tests/platform-admin-boundary.test.mjs",
    "build:agent-worker": "npm run build --workspace @painter-os-bts/agent-worker",
    "test:local-pi-viewer": "node scripts/run-pi-run-viewer.mjs",
    "test:agent-worker": "npm run test --workspace @painter-os-bts/agent-worker",
    "test:node-mjs": "node --test tests/*.test.mjs",
    "test:factory-contracts": "node --test .github/factory/contract.test.mjs",
    "test:visual-regression": "playwright test --config=playwright.visual.config.ts"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@painter-os-bts/config": "*",
    "@types/node": "^26.4.1",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "varlock": "1.18.0",
    "tsx": "4.21.0",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.4",
    "@playwright/test": "1.57.0",
    "convex-test": "0.0.59",
    "vitest": "4.1.11",
    "@edge-runtime/vm": "5.0.0"
  },
  "packageManager": "npm@11.16.0",
  "allowScripts": {
    "esbuild": true,
    "sharp": true
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11.16.0"
  }
}
