  "tokens": {
    "color": {
      "dark": {
        "background": "#0f172a",
        "foreground": "#f8fafc",
        "primary": "#60a5fa"
      },
      "light": {
        "background": "#ffffff",
        "foreground": "#0f172a",
        "primary": "#2563eb"
      }
    },
    "motion": {
      "easing": "ease-out",
      "fastMs": 120,
      "normalMs": 200,
      "reducedMotion": "respect-system"
    },
    "radii": {
      "cardPx": 12,
      "controlPx": 8
    },
    "spacing": {
      "scale": [
        0,
        1,
        2,
        3,
        4,
        6,
        8
      ],
      "unitPx": 4
    },
    "theme": {
      "default": "system",
      "supported": [
        "light",
        "dark"
      ]
    },
    "type": {
      "bodyPx": 16,
      "fontFamily": "system-ui, sans-serif",
      "headingPx": 32
    }
  },
  "ui": {
    "bindings": [
      {
        "componentRef": "core",
        "operations": [
          "inspectRecord",
          "listJobs"
        ],
        "view": "contractorOverview"
      },
      {
        "componentRef": "painting",
        "operations": [
          "create",
          "get",
          "update"
        ],
        "view": "paintingEditor"
      }
    ],
    "componentDirectory": "packages/ui/src/components",
    "items": [
      "button",
      "card",
      "input",
      "table"
    ],
    "library": "shadcn/ui",
    "packageDirectory": "packages/ui",
    "registry": "https://ui.shadcn.com/r/styles/base-lyra/{name}.json",
    "status": "declaration_only",
    "style": "base-lyra",
    "tokensFile": "packages/ui/src/styles/globals.css"
  }
