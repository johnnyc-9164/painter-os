    "argv": [
      "npx",
      "--yes",
      "create-better-t-stack@3.44.2",
      "create-json",
      "--input",
      "{\"addons\":[],\"api\":\"none\",\"auth\":\"none\",\"backend\":\"convex\",\"database\":\"none\",\"dbSetup\":\"none\",\"directoryConflict\":\"error\",\"disableAnalytics\":true,\"dryRun\":true,\"examples\":[],\"frontend\":[\"next\"],\"git\":false,\"install\":false,\"orm\":\"none\",\"packageManager\":\"npm\",\"payments\":\"none\",\"projectName\":\"contractor-os\",\"runtime\":\"none\",\"serverDeploy\":\"none\",\"webDeploy\":\"none\",\"yes\":true}"
