      "api": "none",
      "auth": "none",
      "backend": "convex",
      "database": "none",
      "dbSetup": "none",
      "directoryConflict": "error",
      "disableAnalytics": true,
      "dryRun": true,
      "examples": [],
      "frontend": [
        "next"
      ],
      "git": false,
      "install": false,
