{
  "name": "@johnny/contractor-os-core",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Contractor OS Convex Component: isolated contractor domain state, transactional commands, immutable events, projections, host-authenticated clients, and component-boundary verification.",
  "exports": {
    ".": "./src/backendClient.ts",
    "./convex.config": "./src/component/convex.config.ts",
    "./model": "./src/shared/model.ts",
    "./validation": "./src/shared/port.ts",
    "./domain": "./src/domainClient.ts",
    "./domain-model": "./src/shared/domain.ts",
    "./domain-validators": "./src/component/domainValidators.ts",
    "./convex.config.js": "./src/component/convex.config.ts",
    "./_generated/component": "./src/component/_generated/component.ts",
    "./_generated/component.js": "./src/component/_generated/component.ts",
    "./test": "./src/test.ts",
    "./catalog": "./src/client.ts",
    "./backend": "./src/backendClient.ts",
    "./business": "./src/shared/business.ts",
    "./workflow-validators": "./src/component/businessValidators.ts",
    "./operation-validators": "./src/component/operationValidators.ts",
    "./calculations": "./src/shared/calculations.ts",
    "./projections": "./src/shared/projections.ts",
    "./projection-validators": "./src/component/projectionValidators.ts",
    "./scorecards": "./src/shared/scorecards.ts",
    "./migration": "./src/shared/migration.ts",
    "./version": "./src/shared/version.ts",
    "./trades/painting/convex.config": "./src/trades/painting/component/convex.config.ts",
    "./trades/painting/client": "./src/trades/painting/client.ts",
    "./trades/painting/test": "./src/trades/painting/test.ts",
    "./trades/painting/validators": "./src/trades/painting/component/validators.ts",
    "./trades/plumbing/convex.config": "./src/trades/plumbing/component/convex.config.ts",
    "./trades/plumbing/client": "./src/trades/plumbing/client.ts",
    "./trades/plumbing/test": "./src/trades/plumbing/test.ts",
    "./trades/plumbing/validators": "./src/trades/plumbing/component/validators.ts",
    "./trades/roofing/convex.config": "./src/trades/roofing/component/convex.config.ts",
    "./trades/roofing/client": "./src/trades/roofing/client.ts",
    "./trades/roofing/test": "./src/trades/roofing/test.ts",
    "./trades/roofing/validators": "./src/trades/roofing/component/validators.ts",
    "./trades/garage_door/convex.config": "./src/trades/garage_door/component/convex.config.ts",
    "./trades/garage_door/client": "./src/trades/garage_door/client.ts",
    "./trades/garage_door/test": "./src/trades/garage_door/test.ts",
    "./trades/garage_door/validators": "./src/trades/garage_door/component/validators.ts",
    "./trades/electrical/convex.config": "./src/trades/electrical/component/convex.config.ts",
    "./trades/electrical/client": "./src/trades/electrical/client.ts",
    "./trades/electrical/test": "./src/trades/electrical/test.ts",
    "./trades/electrical/validators": "./src/trades/electrical/component/validators.ts",
    "./trades/hvac/convex.config": "./src/trades/hvac/component/convex.config.ts",
    "./trades/hvac/client": "./src/trades/hvac/client.ts",
    "./trades/hvac/test": "./src/trades/hvac/test.ts",
    "./trades/hvac/validators": "./src/trades/hvac/component/validators.ts",
    "./trades/concrete/convex.config": "./src/trades/concrete/component/convex.config.ts",
    "./trades/concrete/client": "./src/trades/concrete/client.ts",
    "./trades/concrete/test": "./src/trades/concrete/test.ts",
    "./trades/concrete/validators": "./src/trades/concrete/component/validators.ts",
    "./trades/landscaping/convex.config": "./src/trades/landscaping/component/convex.config.ts",
    "./trades/landscaping/client": "./src/trades/landscaping/client.ts",
    "./trades/landscaping/test": "./src/trades/landscaping/test.ts",
    "./trades/landscaping/validators": "./src/trades/landscaping/component/validators.ts",
    "./trades/drywall_framing/convex.config": "./src/trades/drywall_framing/component/convex.config.ts",
    "./trades/drywall_framing/client": "./src/trades/drywall_framing/client.ts",
    "./trades/drywall_framing/test": "./src/trades/drywall_framing/test.ts",
    "./trades/drywall_framing/validators": "./src/trades/drywall_framing/component/validators.ts",
    "./trade-model": "./src/shared/tradeTypes.ts",
    "./trade-validation": "./src/shared/tradeValidation.ts"
  },
  "files": [
    "src",
    "model",
    "README.md",
    "docs",
    "tools",
    "tests",
    "tsconfig.json",
    "tsconfig.core.json",
    "vitest.config.ts",
    "convex.json",
    "examples"
  ],
  "scripts": {
    "build:core": "tsc -p tsconfig.core.json",
    "test": "npm run build:core && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:integration": "vitest run",
    "codegen": "convex codegen --component-dir ./src/component",
    "check:generated": "python3 tools/generate_domain.py --check",
    "verify": "npm test && npm run check:generated && npm run check:component",
    "verify:sdk": "convex dev --once --typecheck-components && npm run typecheck && npm run test:integration",
    "test:business": "npm run build:core && node --test tests/business*.test.mjs tests/backend-adapter.test.mjs",
    "check:syntax": "node tools/check_syntax.cjs",
    "test:formulas": "npm run build:core && node --test tests/calculations-v040.test.mjs",
    "test:core": "npm test",
    "check:component": "node tools/check_component_contract.mjs",
    "check:packaged-component": "node tools/check_component_contract.mjs --require-generated",
    "prepare:component": "npm run codegen && npm run typecheck",
    "pack:dry-run": "npm pack --dry-run --ignore-scripts",
    "check:trades": "python3 tools/generate_trades.py --check",
    "verify:all": "npm run verify && npm run typecheck && npm run test:integration && npm run check:syntax && npm run check:packaged-component && npm run check:composition",
    "check:composition": "python3 tools/validate_composition.py && python3 -m unittest discover -s tests -p test_composition.py"
  },
  "peerDependencies": {
    "convex": ">=1.43.0 <2",
    "convex-helpers": ">=0.1.124 <1"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "convex": "1.46.0",
    "convex-helpers": "0.1.124",
    "convex-test": "0.0.59",
    "vitest": "4.1.11",
    "@edge-runtime/vm": "5.0.0",
    "vite": "8.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
